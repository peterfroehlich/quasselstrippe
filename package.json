{
  "name": "quasselstrippe",
  "version": "1.0.3",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client && npm run build -w server",
    "build:client": "npm run build -w client",
    "build:server": "npm run build -w server",
    "start": "npm run start -w server",
    "docker:build": "docker build -t quasselstrippe .",
    "docker:build:backend": "docker build -f Dockerfile.backend -t quasselstrippe-backend .",
    "docker:build:frontend": "docker build -f Dockerfile.frontend -t quasselstrippe-frontend .",
    "docker:run": "docker compose up --build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
