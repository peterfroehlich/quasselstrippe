# Stage 1: Build server TypeScript
FROM node:22-alpine AS builder

WORKDIR /app

# Copy root workspace and server manifests
COPY package.json package-lock.json ./
COPY server/package.json ./server/

# Install dependencies needed for compiling
RUN npm ci -w server

# Copy server source files
COPY server/ ./server/

# Build TypeScript to server/dist
RUN npm run build -w server

# Stage 2: Production runtime image
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production \
    PORT=3001 \
    DATABASE_PATH=/data/quasselstrippe.db

# Copy package manifests for production install
COPY package.json package-lock.json ./
COPY server/package.json ./server/

# Install only production dependencies
RUN npm ci --omit=dev -w server

# Copy compiled backend from builder
COPY --from=builder /app/server/dist ./server/dist

# Prepare data directory for SQLite database storage and set ownership
RUN mkdir -p /data && chown -R node:node /data /app

# Run as non-root user for container security
USER node

EXPOSE 3001

VOLUME ["/data"]

HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
  CMD node -e "fetch('http://localhost:3001/readyz').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["node", "server/dist/index.js"]
